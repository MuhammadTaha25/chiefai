# Infomist environment reference. NAMES ONLY - never commit real values.
# Copy to .env.local (dev) or set in the hosting provider (production).

# ---- Core -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
# Public HTTPS origin of the deployed app, no trailing slash. REQUIRED in
# production: used for Mailgun/Zernio/Stripe callbacks and the Vibe OAuth redirect.
#
# This is the "bridge". Everything external is pointed at it:
#   Mailgun routes, Zernio webhook subscriptions, Stripe + Calendly endpoints,
#   and every Twilio number's VoiceUrl.
#
# If it changes (a quick tunnel gets a new URL on every restart) the bridge
# breaks silently, so POST /api/cron/sync-endpoints re-points the Zernio
# webhooks AND the Twilio numbers at the current value. It runs on a schedule
# and is idempotent, so a stale origin repairs itself. For a URL that never
# changes, use a Cloudflare named tunnel or a real deployment — see VOICE_SETUP.md.
PUBLIC_APP_URL=
# Secret for signing OAuth `state`. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset;
# set an independent random value in production.
OAUTH_STATE_SECRET=
# Your external scheduler (see CRONS.md) must send `Authorization: Bearer $CRON_SECRET`. Cron routes reject everything if unset.
CRON_SECRET=
# First-deploy safety: the hourly follow-up cron sends NOTHING unless this is exactly "true".
FOLLOW_UP_CRON_ENABLED=false

# ---- Email (Mailgun) --------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_API_BASE_URL=
# HTTP webhook signing key (GET /v5/accounts/http_signing_key). Inbound webhooks
# are rejected (401) when this is unset.
MAILGUN_WEBHOOK_SIGNING_KEY=
#   Mailgun route (catch-all) -> forward to:  $PUBLIC_APP_URL/api/webhooks/mailgun
#   Tracking webhooks (registered by the app) -> $PUBLIC_APP_URL/api/webhooks/mailgun/events

# ---- Domains (Hostinger) ----------------------------------------------
HOSTINGER_API_KEY=
HOSTINGER_BASE_URL=
HOSTINGER_PAYMENT_METHOD_ID=
HOSTINGER_WHOIS_PROFILE_ID=

# ---- Payments (Stripe) ------------------------------------------------
STRIPE_SECRET_KEY=
# Endpoint to create in Stripe: $PUBLIC_APP_URL/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# ---- Calendly ---------------------------------------------------------
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Redirect URI to register in the Calendly OAuth app: $PUBLIC_APP_URL/api/calendly/callback
CALENDLY_OAUTH_REDIRECT_URI=
# Webhook subscriptions need a paid Calendly plan; without one the app polls
# (/api/cron/calendly-sync).

# ---- Social / Ads (Zernio + Meta) -------------------------------------
ZERNIO_BASE_URL=
ZERNIO_API_KEY_GOOGLE_META=
ZERNIO_API_KEY_TIKTOK_INSTAGRAM=
# Zernio webhook target: $PUBLIC_APP_URL/api/webhooks/zernio  (signature required)
ZERNIO_WEBHOOK_SECRET=
# OAuth return path used by Zernio connect: $PUBLIC_APP_URL/api/zernio/callback

# ---- AI / prospecting -------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
EXPLORIUM_API_KEY=                  # optional fallback prospecting source
EXPLORIUM_BASE_URL=
# Vibe Prospecting is authorised once via its OAuth flow; its redirect is
# $PUBLIC_APP_URL/api/vibe-prospecting/callback

# ---- Voice numbers (via n8n) ------------------------------------------
# The Twilio + ElevenLabs credentials live in n8n, NOT in this app. The app calls the
# authenticated n8n workflow "Infomist - Voice Provider (App-Called)":
#   $N8N_BASE_URL/webhook/infomist-voice-provider   (header X-Webhook-Secret: $N8N_WEBHOOK_SECRET)
# Required for /api/voice/provision-number to be available: N8N_BASE_URL, N8N_WEBHOOK_SECRET
# (both below under Optional / legacy) and ELEVENLABS_AGENT_ID.
# n8n server environment must also define TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN.
ELEVENLABS_AGENT_ID=                # the shared ElevenLabs voice agent every provisioned number is assigned to
# Buying a number costs real money. Purchasing is a SEPARATE explicit switch: it stays disabled
# unless this is exactly "true", even when everything above is configured. It also gates the
# daily outbound report calls, which spend money per minute.
VOICE_PURCHASE_ENABLED=
VOICE_COUNTRY_CODE=                 # optional, default US
# Shared secret the voice agent presents when it calls POST /api/voice/facts to read a
# tenant's numbers while somebody is on the phone. Falls back to N8N_WEBHOOK_SECRET when
# unset. The tenant is resolved from the number that was DIALED, never from the request.
VOICE_FACTS_SECRET=

# ---- Optional / legacy ------------------------------------------------
# Used ONLY by the parked voice-number provisioning path (see above). No other feature calls n8n.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
DAILY_SEND_MIN_DELAY_MS=
DAILY_SEND_MAX_DELAY_MS=

# ---- DEV ONLY - must NOT be set in production -------------------------
# ALLOW_UNSIGNED_WEBHOOKS=true is ignored when NODE_ENV=production, but leave it unset anyway.
ALLOW_UNSIGNED_WEBHOOKS=
DEV_AUTOLOGIN_EMAIL=
DEV_AUTOLOGIN_PASSWORD=
